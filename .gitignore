# Hard constraint: vendor/ is built in CI and shipped in the zip, never committed.
# See DECISIONS.md section 1 and the release workflow.
/vendor/
/build/scoped/
/build/dist/

# Tooling
/.phpunit.cache/
/.phpunit.result.cache
/phpcs.xml
/phpstan.neon
/phpunit.xml
/.phpcs-cache

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/

# Build intermediates. The zip is a release artifact, not a repository file.
/build/scratch/
/build/stage/

# Written by build/build-zip.sh on every build.
/build/vendor-version.php

# The build tools resolve against the build machine's PHP rather than the
# plugin's floor, so they carry their own manifest -- which is tracked. Its
# vendor is not.
/build/tools/vendor/
